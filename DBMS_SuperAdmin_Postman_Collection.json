{
  "info": {
    "_postman_id": "dbms-superadmin-api-v1",
    "name": "DBMS SuperAdmin API",
    "description": "Comprehensive API collection for DBMS SuperAdmin Backend. Includes automatic token capture upon login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3007",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserId",
      "value": "671e6267814b1a456c7d8e90",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Server",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Login (Auto-captures Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "        console.log('AccessToken captured successfully!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"shivanshcoc11@gmail.com\",\n  \"password\": \"Bhoolgy@12\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Verify Token (Protected Test)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/test/protected",
              "host": ["{{baseUrl}}"],
              "path": ["api", "test", "protected"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Users Management",
      "item": [
        {
          "name": "List Users (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "role", "value": "admin", "disabled": true },
                { "key": "isActive", "value": "true", "disabled": true },
                { "key": "projectId", "value": "PRJ-DATABASE-MIGRATION", "disabled": true },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('testUserId', json.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bruce Wayne\",\n  \"email\": \"bruce.wayne@wayne-enterprises.com\",\n  \"password\": \"BatcaveSecurity#2026\",\n  \"role\": \"admin\",\n  \"projectIds\": [\"PRJ-SURVEILLANCE\", \"PRJ-CLOUD-INFRA\"],\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bruce T. Wayne\",\n  \"projectIds\": [\"PRJ-SURVEILLANCE\", \"PRJ-CLOUD-INFRA\", \"PRJ-SATELLITE-GRID\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}"]
            }
          }
        },
        {
          "name": "Toggle User Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}", "status"]
            }
          }
        },
        {
          "name": "Reset User Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"FreshSecurePassword#2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}", "reset-password"]
            }
          }
        },
        {
          "name": "Delete User (Super Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "{{testUserId}}"]
            }
          }
        }
      ]
    }
  ]
}

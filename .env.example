# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3007
FRONTEND_URL=http://localhost:5173

# ==========================================
# DATABASE (MongoDB)
# ==========================================
MONGODB_URI=mongodb://localhost:27017/dbms_superadmin

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Must be at least 32 characters long
JWT_ACCESS_SECRET=your_jwt_secret_key_at_least_32_characters_long_here
JWT_ACCESS_EXPIRES_IN=15m

# ==========================================
# INITIAL SUPER ADMIN BOOTSTRAP
# (Used when running: npm run bootstrap:superadmin)
# ==========================================
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@example.com
# Must contain at least 12 characters
SUPERADMIN_PASSWORD=SuperAdminPassword123!
